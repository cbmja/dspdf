<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.daishin.pdf.mapper.ErrorMapper">

    <sql id="searchColumn">
        <choose>
            <when test="cate == 'CREATE_DATE'">CONVERT(NVARCHAR(33), CREATE_DATE, 126)</when>
            <otherwise>${cate}</otherwise>
        </choose>
    </sql>

    <insert id="save" parameterType="Error">
        INSERT INTO ERROR
        (ERROR_MESSAGE
        ,CREATE_DATE
        ,MASTER_KEY
        ,ERROR_CODE
        )
        VALUES
        (#{ERROR_MESSAGE}
        ,CURRENT_TIMESTAMP
        ,#{MASTER_KEY}
        ,#{ERROR_CODE}
        )
    </insert>

    <select id="countSearch" resultType="int" parameterType="com.daishin.pdf.page.ErrorSearch">
        SELECT COUNT(*) FROM ERROR WHERE <include refid="searchColumn"/> LIKE CONCAT(N'%', #{search}, N'%') AND CREATE_DATE BETWEEN #{startDate} AND #{endDate}
    </select>

    <select id="selectErrorsByPage" parameterType="com.daishin.pdf.page.Page" resultType="Error">
        SELECT * FROM ERROR WHERE <include refid="searchColumn"/> LIKE CONCAT(N'%', #{search}, N'%') AND CREATE_DATE BETWEEN #{startDate} AND #{endDate}
        ORDER BY ${sortCate} ${sort}, ID ASC
        OFFSET #{startNum} ROWS FETCH NEXT #{pageElement} ROWS ONLY
    </select>

    <select id="selectById" parameterType="String" resultType="Error">
        SELECT * FROM ERROR WHERE ID = #{id}
    </select>

</mapper>
